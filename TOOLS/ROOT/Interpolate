#include "Math/Interpolator.h"
#include <vector>
#include <iostream>

void interpolate_example() {
    std::vector<double> x = {0.0, 1.0, 2.0, 3.0, 4.0};
    std::vector<double> y = {0.0, 0.8, 0.9, 0.1, -0.7};

    // Instantiate interpolator with a cubic spline
    ROOT::Math::Interpolator interp(x, y, ROOT::Math::Interpolation::CSPLINE);

    // Evaluate at a specific point
    double x_val = 1.5;
    double y_val = interp.Eval(x_val);
    std::cout << "Interpolated value at " << x_val << " is " << y_val << std::endl;
}
